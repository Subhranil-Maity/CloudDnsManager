<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.CloudDnsManager" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Launch theme: shows the app icon on a dark branded background until MainActivity is
         ready (session + app-lock state resolved), then switches to Theme.CloudDnsManager. -->
    <style name="Theme.CloudDnsManager.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.CloudDnsManager</item>
    </style>
</resources>
